{
  "name": "kurator-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "26.13.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0 && node --test scripts/architecture.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript openapi/backend.openapi.yaml -o src/shared/api/generated/schema.d.ts",
    "api:generated:check": "node scripts/check-generated-api.mjs",
    "api:contract:check": "node scripts/check-api-contract.mjs",
    "api:contract:update": "node scripts/update-api-contract.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm api:generated:check && pnpm test:smoke"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.91.0",
    "react-router": "8.5.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
